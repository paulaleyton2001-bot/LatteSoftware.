# ==========================================================================
# LatteCoffe POS - variables de entorno del backend
# --------------------------------------------------------------------------
# Copiar a `.env` y ajustar. NUNCA subir `.env` al repositorio.
# Todas las variables son obligatorias salvo que se indique `[opcional]`.
# ==========================================================================

# --- Entorno de ejecución -------------------------------------------------
# `production` activa el modo estricto: secretos débiles y mensajes de error
# genéricos sin stack trace.
NODE_ENV=development
# Entorno de la aplicación (independiente de como se ejecuta node).
# Valores previstos: `development` | `staging` | `production`.
APP_ENV=development

# --- Servidor HTTP --------------------------------------------------------
PORT=3000
HOST=0.0.0.0
APP_NAME=LatteCoffe API
APP_VERSION=1.0.0

# --- Base de datos (SQLite) ----------------------------------------------
# Ruta del fichero SQLite. Relativa a la raíz de `backend/`.
DATABASE_PATH=./data/lattecoffe.sqlite
# Tiempo que SQLite espera un bloqueo antes de devolver SQLITE_BUSY (ms).
DATABASE_BUSY_TIMEOUT_MS=5000

# --- Seguridad / JWT ------------------------------------------------------
# OJO: el nombre lo fija el contrato de despliegue. OBLIGATORIO y con
# al menos 32 caracteres. En `APP_ENV=production` se rechazan valores débiles
# (patrones de ejemplo, "changeme", "secret", "password", "12345"...).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DATABASE_JWT_SECRET=cambie-esto-por-un-secreto-aleatorio-de-64-caracteres
# TTL del access token (segundos o unidades estilo "15m" si se antepone "expiresIn").
JWT_ACCESS_TTL=15m
# Vigencia del refresh token en días.
JWT_REFRESH_TTL_DAYS=30
# Coste de bcrypt para hash de contraseñas (10-15). 12 por defecto.
BCRYPT_COST_ROUNDS=12
# Vigencia del token de reseteo de contraseña, en minutos (DESIGN.md 4.1: 30).
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Base del enlace de reseteo. Sólo se usa para el log de DESARROLLO: en
# producción el token viaja por el proveedor de correo, nunca por el log.
RESET_PASSWORD_LINK_BASE_URL=http://localhost:5173/reset-password

# --- CORS -----------------------------------------------------------------
# Lista blanca separada por comas. `*` habilita cualquier origen (solo desarrollo).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Logging --------------------------------------------------------------
# Traza: 10 | depuración: 20 | info: 30 | aviso: 40 | error: 50 | fatal: 60
LOG_LEVEL=info

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Límite más estricto para /api/v1/auth/* (fuerza bruta de contraseñas).
AUTH_RATE_LIMIT_MAX=20
# Límite REFORZADO de recuperación de contraseña (forgot/reset), con ventana de
# una hora. Es un límite separado del anterior y no se relaja: se aplica sobre
# `forgot-password` y `reset-password`, que son las rutas que permiten enumerar
# cuentas o martillear un correo.
AUTH_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
AUTH_PASSWORD_RATE_LIMIT_MAX=3

# --- Pagos ----------------------------------------------------------------
# Proveedor por defecto: `MOCK` (no conecta a nada) | `STRIPE` | `WOMPI` | ...
PAYMENT_PROVIDER=MOCK
# Secreto del proveedor de pagos. En `APP_ENV=production` es obligatorio.
PAYMENT_SECRET=

# --- Formatos por defecto -------------------------------------------------
# Se usan como fallback cuando la tabla `businesses` aún no está sembrada.
DEFAULT_CURRENCY=COP
DEFAULT_TIMEZONE=America/Bogota

# --- Migraciones ----------------------------------------------------------
# `true` ejecuta `migrate up` y `seed` dentro de `npm start`.
# Por defecto las migraciones son un comando explícito (`npm run migrate`).
SEED_ON_MIGRATE=false

# --- Semilla de cuentas de sistema ----------------------------------------
# `npm run seed` crea el negocio singleton (businesses.id = 1), los 6 roles, los
# 83 permisos, la matriz de RBAC y estas CUATRO cuentas mínimas para poder operar:
#   owner@lattecoffe.co    (OWNER)
#   admin@lattecoffe.co    (ADMIN)
#   manager@lattecoffe.co  (MANAGER)
#   cajero@lattecoffe.co   (CASHIER)
# La semilla NO es destructiva: si la cuenta ya existe no la toca, así que
# cambiar la contraseña y volver a sembrar no la restaura.
# En APP_ENV=production esta semilla se DESACTIVA siempre, y ponerla a `true`
# hace abortar el arranque: una contraseña compartida en el repositorio es una
# puerta abierta.
SEED_SYSTEM_ACCOUNTS=true
# Contraseña de esas cuentas. SOLO desarrollo: cámbiela o desactive la semilla
# antes de abrir el local. Cumple la política de contraseñas del backend
# (3 de 4 clases). IMPORTANTE: entrecomíllala si lleva `#`, porque sin comillas
# `dotenv` la corta ahí y la contraseña se quedaría en `LatteCofee`.
SEED_SYSTEM_ACCOUNTS_PASSWORD="LatteCofee#2026"

# --- Semilla de DATOS DE DEMOSTRACIÓN --------------------------------------
# Fuera de producción, `npm run seed` siembra además 1 sede, 5 zonas, 25 sillas,
# un catálogo de 6 categorías y 24 productos, 5 cupones, empleados, clientes,
# reservas, alquileres y 18 pedidos con su historial y sus cobros: lo justo para
# navegar la API y ver reportes con datos dentro sin escribir nada a mano.
#   SEED_DEMO_DATA      `false` apaga esos datos y deja SÓLO la estructura
#                       (roles, permisos, negocio, sede y cuentas de sistema).
#                       En APP_ENV=production se ignoran por completo aunque
#                       valga `true`: una base real no se siembra con datos
#                       falsos. Sin esta variable los datos de demo se siembran.
#   SEED_DEMO_PASSWORD  Contraseña de los empleados y clientes de demostración.
#                       Si no se pone, se reutiliza
#                       `SEED_SYSTEM_ACCOUNTS_PASSWORD`. Si AMBAS están vacías,
#                       no se crean esos usuarios y la semilla lo avisa por log.
#                       Si se pone, cámbiela: la de las cuentas de sistema es
#                       pública. Entrecomíllala si lleva `#` (mismo motivo que
#                       arriba).
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=""
