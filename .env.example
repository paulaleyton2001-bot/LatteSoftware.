# =============================================================================
# LatteCoffe API — variables de entorno para Docker Compose
# =============================================================================
# COPIAR a `.env` y EDITAR. El `.env` real NUNCA se versiona (ya está en
# `.gitignore`). Este fichero es la PLANTILLA: no contiene ningún secreto real.
#
#   cp .env.example .env
#   # generar un secreto de verdad:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   # pegarlo en DATABASE_JWT_SECRET
#
# Las dos variables marcadas con `${...?}` en `docker-compose.yml` NO tienen
# valor por defecto: si faltan, `docker compose` ABORTA antes de arrancar nada.
# Es deliberado — es preferible un fallo temprano y ruidoso que un contenedor
# vivo con un secreto de relleno.
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLISH (puerto)
# -----------------------------------------------------------------------------
# Interfaz donde se publica el puerto 3000 del contenedor.
# `127.0.0.1` = sólo local en el servidor (lo que usa el túnel).
# `0.0.0.0`    = accesible desde la red del servidor. Abrir esto sin pensarlo
#                deja la API de la cafetería a medio mundo.
API_BIND=127.0.0.1
API_PORT=3000


# -----------------------------------------------------------------------------
# ENTORNO DE APLICACIÓN
# -----------------------------------------------------------------------------
# `staging` en esta entrega, y es INTENCIONAL:
# con `APP_ENV=production` el backend se niega a sembrar datos de demostración
# ni a crear las cuentas de sistema (ver `backend/src/config/env.ts` y
# `backend/src/database/seeds/demo-support.ts`). Sin semilla no hay catálogo de
# 24 productos ni cuentas con las que entrar, que es lo que se entrega.
#
# Para un despliegue real: `APP_ENV=production` + `SEED_SYSTEM_ACCOUNTS=false` y
# crear el primer OWNER a mano. El arranque aborta si se intenta sembrar
# cuentas de sistema en producción.
APP_ENV=staging
APP_NAME=LatteCoffe API
APP_VERSION=1.0.0


# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# `DATABASE_PATH` NO se pone aquí a propósito: lo fija `docker-compose.yml` a
# `/data/lattecoffe.sqlite`, que es la ruta del volumen. Si se define en este
# fichero se ignora, y si se apunta a otro sitio la base no se persiste.
#
# Tiempo que SQLite espera un bloqueo antes de devolver SQLITE_BUSY (ms).
DATABASE_BUSY_TIMEOUT_MS=5000


# -----------------------------------------------------------------------------
# SEGURIDAD
# -----------------------------------------------------------------------------
# OBLIGATORIA. Mínimo 32 caracteres.
# En `APP_ENV=production` el arranque ABORTA si es débil: menos de 32 chars,
# un carácter repetido, menos de 8 distintos, o si contiene `changeme`, `secret`,
# `password`, `admin`, `root`, `test`, `demo`, `example`, `placeholder`,
# `qwerty` o `lattecoffe`.
#
# GENERAR:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DATABASE_JWT_SECRET=PEGUE_AQUI_EL_SEGUNDO_GENERADO_CON_EL_COMANDO_DE_ARRIBA

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_COST_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
RESET_PASSWORD_LINK_BASE_URL=http://localhost:5173/reset-password


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Lista separada por comas. `*` habilita cualquier origen: está bien para esta
# entrega (el APK de Android no lo consulta), pero en producción hay que poner
# los orígenes reales.
CORS_ORIGINS=*


# -----------------------------------------------------------------------------
# LOGGING Y RATE LIMITING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AUTH_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
AUTH_PASSWORD_RATE_LIMIT_MAX=3


# -----------------------------------------------------------------------------
# PAGOS
# -----------------------------------------------------------------------------
# MOCK: no se contacta ninguna pasarela real. `PAYMENT_SECRET` sólo es
# obligatoria si `PAYMENT_PROVIDER` deja de ser MOCK.
PAYMENT_PROVIDER=MOCK
PAYMENT_SECRET=


# -----------------------------------------------------------------------------
# NEGOCIO
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=COP
DEFAULT_TIMEZONE=America/Bogota


# -----------------------------------------------------------------------------
# SEMILLA (`docker compose run --rm api npm run seed:prod`)
# -----------------------------------------------------------------------------
# El esquema NUNCA se crea al arrancar el servidor: `migrate` y `seed` son
# comandos explícitos. Estos flags sólo afectan a `seed:prod`.
SEED_DEMO_DATA=true
SEED_SYSTEM_ACCOUNTS=true

# OBLIGATORIA si `SEED_SYSTEM_ACCOUNTS=true`. Es la contraseña con la que se
# crean las cuentas de demo. Debe cumplir la política de contraseñas del
# backend (mayúscula, minúscula, dígito y símbolo; mínimo razonable).
#
# ADVERTENCIA: es una contraseña de DEMOSTRACIÓN, escrita en este repositorio.
# Cualquiera que lo lea puede entrar como OWNER. Antes de abrir el local de
# verdad, cámbiala en cada cuenta y deja de sembrar cuentas de sistema.
SEED_SYSTEM_ACCOUNTS_PASSWORD=PEGUE_AQUI_LA_CONTRASENA_DE_DEMO_DEL_SEMILLADO
